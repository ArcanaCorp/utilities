APIS_PERU_TOKEN=tu_token
LICENSING_API_TOKEN=define_un_secreto_aleatorio_de_al_menos_32_caracteres
# Activa el formulario y endpoint UI solo si el deployment está protegido por acceso administrativo.
LICENSING_UI_ENABLED=true
# En local se usa esta clave privada; en despliegues configura LICENSING_PRIVATE_KEY
# como variable secreta y no subas el archivo PEM.
LICENSING_PRIVATE_KEY_PATH=private/licensing/arcna1.pem
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.18.10:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Solo direcciones/subredes de proxies confiables; vacío para acceso directo.
TRUST_PROXY=